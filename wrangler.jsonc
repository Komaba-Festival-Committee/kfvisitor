{
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "production": {
      "name": "kfvisitor-prod",
      "workers_dev": false,
      "preview_urls": false
    },
    "qa": {
      "name": "kfvisitor-qa",
      "workers_dev": false,
      "preview_urls": false
    },
    "preview": {
      "name": "preview-pr"
    }
  }
}
